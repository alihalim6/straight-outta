{
  "name": "straight-outta",
  "private": true,
  "version": "0.0.1",
  "description": "Local-first music discovery app with Electron desktop runtime",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "api": "node server/api.js",
    "electron:dev": "wait-on tcp:3001 http://127.0.0.1:5173 && ELECTRON_MANAGED_API=0 ELECTRON_START_URL=http://127.0.0.1:5173 electron .",
    "dev:desktop": "concurrently -k -n api,web,desktop \"npm:api\" \"npm:dev:web\" \"npm:electron:dev\"",
    "desktop": "npm run build && electron .",
    "prepare:python-deps": "python3 -m pip install --upgrade --target backend/playlist_refresher/.python_packages -r backend/playlist_refresher/requirements.txt",
    "pack:mac": "npm run prepare:python-deps && npm run build && electron-builder --mac",
    "pack:mac:dmg": "npm run prepare:python-deps && npm run build && electron-builder --mac dmg",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "express": "^4.21.0",
    "pg": "8.20.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "7.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "9.2.1",
    "electron": "41.3.0",
    "electron-builder": "26.8.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^7.3.1",
    "wait-on": "9.0.5"
  },
  "build": {
    "appId": "fm.straightoutta.local",
    "productName": "Straight Outta",
    "icon": "assets/logo-icon.png",
    "asarUnpack": [
      "backend/playlist_refresher/**"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "backend/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "assets/logo-icon.png",
      "target": [
        "zip"
      ],
      "category": "public.app-category.music"
    }
  }
}
