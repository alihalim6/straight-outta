# Frontend (Vite). Copy to .env in repo root.
# Spotify PKCE: dashboard -> your app -> Redirect URIs must match getRedirectUri() exactly.
# Spotify does not allow "localhost" in redirect URIs; dev: register http://127.0.0.1:5173/callback and open http://127.0.0.1:5173
# Optional: exact registered URI (production HTTPS, or loopback for local).
# VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/callback
VITE_SPOTIFY_CLIENT_ID=
# Optional. Defaults to /api/refresh (proxied to the local Node API in dev).
# VITE_API_URL=/api/refresh
# Optional: base URL for redirect (defaults to window.location.origin). Avoid localhost hostname for Spotify.
# VITE_APP_URL=http://127.0.0.1:5173

# Local refresher config used by backend/playlist_refresher
DATABASE_URL=postgresql://postgres:postgres@localhost/straight-outta
PLAYLIST_NAME_SUFFFIX=WAUX 91.7FM:
ARTISTS_PER_QUERY=25
TRACKS_PER_PLAYLIST=50
SPOTIFY_MARKET=US
# Optional: max time (ms) for the local Python refresher subprocess (default 600000).
# REFRESH_EXEC_TIMEOUT_MS=600000
